JARVIS_HUD_TOKEN=replace-with-a-generated-token
API_SERVER_KEY=replace-with-a-generated-hermes-key
BETTER_AUTH_SECRET=generate-32-random-bytes-as-hex
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=generate-a-separate-32-byte-hex-secret
PAPERCLIP_SECRETS_MASTER_KEY=generate-a-separate-32-byte-hex-secret
PAPERCLIP_AGENT_JWT_SECRET=generate-a-separate-32-byte-hex-secret
# Populated by the authenticated REST bootstrap, server-side only:
PAPERCLIP_URL=http://paperclip:3100
# Read-only local inference monitoring; use the Ollama API root, without /v1:
JARVIS_OLLAMA_URL=http://ollama-models:11434
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_PROJECT_ID=
PAPERCLIP_AGENT_ID=
HERMES_PAPERCLIP_AGENT_KEY=

# Isolated CEO runtime; generated by init and authenticated CEO bootstrap:
API_SERVER_CEO_KEY=replace-with-a-separate-generated-hermes-key
PAPERCLIP_CEO_AGENT_ID=
HERMES_PAPERCLIP_CEO_KEY=
JARVIS_EXECUTION_PROOF_KEY=replace-with-a-separate-generated-proof-key
# Optional operator-selected common local model; default keeps existing profiles.
# The selection helper generates its signed, non-secret configuration record.
JARVIS_RUNTIME_MODEL=jarvis-hermes-aigoat24:3b
JARVIS_INFERENCE_CONFIGURATION=
