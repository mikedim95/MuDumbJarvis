FROM node:22.22.0-bookworm-slim@sha256:7cc56ef285a8568121537d17b05e72128f01b89c54607b51acf084a50ef483f3 AS node_runtime
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
COPY --from=node_runtime /usr/local/ /usr/local/
USER root
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server openssh-client libatomic1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --create-home --shell /bin/bash employee \
    && passwd -d employee \
    && mkdir -p /run/sshd /workspace /etc/ssh/jarvis \
    && chown -R 1000:1000 /workspace /etc/ssh/jarvis
RUN mkdir -p /opt/promptfoo && cd /opt/promptfoo && npm init -y \
    && npm install --omit=dev --no-audit --no-fund --save-exact promptfoo@0.125.1 \
    && ln -s /opt/promptfoo/node_modules/.bin/promptfoo /usr/local/bin/promptfoo \
    && npm cache clean --force
ENV PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE_CHECK=1
COPY deploy/sandbox-sshd.conf /etc/ssh/jarvis/sshd_config
COPY hermes-plugin/jarvis_readonly/fixtures/isolation_checks.py /usr/local/share/jarvis/isolation_checks.py
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["/usr/sbin/sshd", "-D", "-e", "-f", "/etc/ssh/jarvis/sshd_config"]
