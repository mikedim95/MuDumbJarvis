# AI-first view and safe Codex binding over the verified command-center image.
ARG HUD_BASE=jarvis-command-center:hud-before-minimal-ai
FROM ${HUD_BASE}
ENV JARVIS_PROJECT_LIFECYCLE_SOCKET=/app/server/logs/.project-lifecycle.sock
COPY --chown=1000:1000 server/server.py server/chat_context.py server/document_permissions.py \
    server/general_knowledge.py server/general_context.py server/administration.py \
    server/project_workspace.py server/project_runtime.py server/work_delivery.py server/token_usage.py \
    server/agent_config_lock.py server/blocker_delivery.py server/csi_events.py \
    server/task_api.py server/task_brief.py server/agent_work.py \
    server/agent_activity.py server/cron_api.py server/work_scope.py \
    server/task_monitor.py /app/server/
COPY --chown=1000:1000 server/hud/index.html server/hud/tasks.js server/hud/package-response.js \
    server/hud/monitor.js server/hud/recovery.js server/hud/ceo-input.js \
    server/hud/modes.js server/hud/team-workspace.js server/hud/project-packages.js \
    server/hud/workspace-panels.js server/hud/workspace-panels.css server/hud/token-usage.js \
    server/hud/token-usage.css server/hud/project-results.js server/hud/general-context.js \
    server/hud/administrator.js server/hud/document-permissions.js server/hud/agents.js \
    server/hud/cron-jobs.js server/hud/ai-minimal.css /app/server/hud/
COPY --chown=1000:1000 hermes-plugin/jarvis_readonly /app/hermes-plugin/jarvis_readonly
COPY --chown=1000:1000 server/hud/portraits /app/server/hud/portraits
COPY --chown=1000:1000 server/hud/csi /app/server/hud/csi
